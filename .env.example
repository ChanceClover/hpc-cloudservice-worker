# Diisi otomatis oleh:  ./hpc.sh setup <COORDINATOR_URL> <WORKER_TOKEN>
# Perintah lengkap (sudah berisi alamat + token Anda) ada di dashboard relawan.

# Alamat koordinator. Dari laptop lain: alamat HTTPS dari admin (mis. https://xxx.trycloudflare.com).
# Satu laptop dengan head node: http://host.docker.internal:8000
COORDINATOR_URL=https://koordinator.example.org
# Token worker pribadi (hpc_w_...). RAHASIA: jangan di-commit (.env sudah di .gitignore).
WORKER_TOKEN=
WORKER_NAME=laptop-relawan
# Batas sandbox worker (CPU & RAM), juga dilaporkan ke koordinator
WORKER_CPUS=1
WORKER_MEMORY_MB=512
